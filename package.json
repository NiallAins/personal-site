{
    "name": "personalsite",
    "main": "main.js",
    "scripts": {
        "dev": "npm run build && bash ./build-scripts/watch.sh",
        "watch": "bash ./build-scripts/watch.sh",
        "build": "bash ./build-scripts/build-style.sh && bash ./build-scripts/build-script.sh && node ./build-scripts/build-template.js",
        "build-prod": "bash ./build-scripts/build-script.sh prod",
        "prep-images": "node ./build-scripts/prep-images.js",
        "push": "bash ./build-scripts/push.sh",
        "push-deploy": "bash ./build-scripts/push.sh prod"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NiallAins/personal-site.git"
    },
    "license": "ISC",
    "homepage": "https://github.com/NiallAins/personal-site#readme",
    "devDependencies": {
        "@img/sharp-win32-x64": "^0.35.1",
        "canvas": "^3.2.3",
        "concurrently": "^9.2.1",
        "http-server": "^14.1.1",
        "onchange": "^7.1.0",
        "sass": "^1.100.0",
        "sharp": "^0.35.1",
        "ts-loader": "^9.5.7",
        "typescript": "^6.0.3",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.2"
    }
}
